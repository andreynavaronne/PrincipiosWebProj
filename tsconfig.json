{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es6",
    "sourceMap": true,
    "strict": true,
    "outDir": "./lib",
    "baseUrl": "./",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
  "skipLibCheck": true
  }, 
  "include": ["src"],
  "exclude": ["node_modules"]
}
