{
  "compilerOptions":{
    "target":"es6",
    "module":"commonjs",
    "declaration":true,
    "outDir":"./lib",
    "strict":true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },

  "include":["src", "swagger.js"],
  "exclude":["node_modules", "**/__tests__/*"]

}
